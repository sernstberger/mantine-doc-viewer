{
  "name": "mantine-doc-viewer",
  "version": "0.0.0",
  "description": "Document viewer for Mantine: PDF, images, text, code and markdown",
  "homepage": "https://sernstberger.github.io/mantine-doc-viewer/",
  "license": "MIT",
  "author": "Steve Ernstberger",
  "keywords": [
    "document-viewer",
    "file-preview",
    "image-viewer",
    "mantine",
    "pdf",
    "pdf-viewer",
    "react"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/types/editor.d.mts",
        "default": "./dist/esm/editor.mjs"
      },
      "require": {
        "types": "./dist/types/editor.d.ts",
        "default": "./dist/cjs/editor.cjs"
      }
    },
    "./markup": {
      "import": {
        "types": "./dist/types/markup.d.mts",
        "default": "./dist/esm/markup.mjs"
      },
      "require": {
        "types": "./dist/types/markup.d.ts",
        "default": "./dist/cjs/markup.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "typesVersions": {
    "*": {
      "editor": [
        "./dist/types/editor.d.ts"
      ],
      "markup": [
        "./dist/types/markup.d.ts"
      ]
    }
  },
  "repository": "https://github.com/sernstberger/mantine-doc-viewer.git",
  "peerDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@mantine/code-highlight": "^9.7.0",
    "@mantine/core": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "pdfjs-dist": "^6.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@cantoo/pdf-lib": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  },
  "dependencies": {
    "@mantine/store": "9.8.0"
  },
  "bugs": "https://github.com/sernstberger/mantine-doc-viewer/issues",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.2.4"
  }
}
