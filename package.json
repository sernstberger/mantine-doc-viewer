{
  "name": "mantine-doc-viewer-monorepo",
  "private": true,
  "description": "This package.json is not published to npm, modify the file in package/package.json",
  "packageManager": "yarn@4.18.1",
  "repository": "sernstberger/mantine-doc-viewer.git",
  "workspaces": [
    "docs",
    "package"
  ],
  "scripts": {
    "clean": "rimraf package/dist",
    "build": "npm run clean && rollup -c rollup.config.mjs && tsx scripts/generate-dts && tsx scripts/prepare-css",
    "check:exports": "attw --pack package --exclude-entrypoints styles.css styles.layer.css",
    "format:test": "oxfmt -c oxfmt.config.mjs --check \"**/*.{ts,tsx,css}\"",
    "format:write": "oxfmt -c oxfmt.config.mjs --write \"**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit && tsx scripts/generate-dts && cd docs && npm run typecheck",
    "lint": "npm run oxlint && npm run stylelint",
    "check:comments": "tsx scripts/check-comments.ts",
    "oxlint": "oxlint -c oxlint.config.mjs --deny-warnings .",
    "stylelint": "stylelint '**/*.css' --cache",
    "jest": "jest",
    "coverage": "jest --coverage",
    "test": "npm run syncpack && npm run format:test && npm run typecheck && npm run lint && npm run check:comments && npm run coverage",
    "release:patch": "tsx scripts/release patch",
    "release:minor": "tsx scripts/release minor",
    "release:major": "tsx scripts/release major",
    "publish:bootstrap": "tsx scripts/publish --bootstrap",
    "publish:dry-run": "tsx scripts/publish --dry-run",
    "size": "node scripts/measure-size.mjs",
    "docgen": "tsx scripts/docgen",
    "story-pdfs": "tsx scripts/generate-story-pdfs.ts",
    "dev": "cd docs && npm run dev",
    "docs:build": "npm run docgen && cd docs && npm run build",
    "storybook": "storybook dev -p 8271",
    "syncpack": "syncpack list-mismatches",
    "syncpack:format": "syncpack format",
    "storybook:build": "storybook build -o storybook-static --quiet --loglevel warn",
    "e2e": "npm run storybook:build && playwright test",
    "e2e:dev": "E2E_DEV=1 playwright test",
    "e2e:ui": "E2E_DEV=1 playwright test --ui"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@mantine-tests/core": "^2.1.0",
    "@mantine/code-highlight": "9.8.0",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/store": "9.8.0",
    "@playwright/test": "^1.65.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11",
    "@types/identity-obj-proxy": "^3",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.15.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/signale": "^1",
    "@types/yargs": "^17.0.33",
    "@vitejs/plugin-react": "^4.5.0",
    "chalk": "^4.1.2",
    "esbuild": "^0.25.5",
    "fs-extra": "^11.3.0",
    "hash-css-selector": "^1.1.0",
    "html-entities": "^2.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "mantine-docgen-script": "^1.5.0",
    "oxc-config-mantine": "^1.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "pdfjs-dist": "^6.5.438",
    "postcss": "^8.5.4",
    "postcss-preset-mantine": "1.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.41.1",
    "rollup-plugin-banner2": "^1.3.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "signale": "^1.4.0",
    "simple-git": "^3.27.0",
    "storybook": "^10.6.3",
    "stylelint": "^16.20.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "syncpack": "^13.0.4",
    "tsx": "^4.19.4",
    "typescript": "6.0.2",
    "version-next": "^1.0.2",
    "vite": "^6.3.5",
    "yargs": "^18.0.0",
    "zx": "^8.5.4"
  }
}
