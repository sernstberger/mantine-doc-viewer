{
  "extends": "./tsconfig.json",
  "include": ["package/src"],
  "exclude": [
    "**/*.test.tsx",
    "**/*.test.ts",
    "**/test-utils.tsx",
    "**/*.story.tsx",
    "**/*.story.ts",
    "package/src/test-utils",
    "package/dist"
  ],
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "rootDir": "package/src"
  }
}
